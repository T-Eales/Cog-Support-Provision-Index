# Corpus / scraped documents / coded output — NEVER committed. These directories exist as
# empty scaffolding only; every file inside them (raw scrapes, extracted passages, coded
# annotations) stays local to the researcher's machine.
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep
data/extracted/
data/coded/**
!data/coded/**/
!data/coded/**/.gitkeep

# Any corpus/export CSV or spreadsheet anywhere in the repo, except the (empty) manifest
# template itself.
*.csv
!data/manifest.csv
*.xlsx

# Python
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/

# Notebook checkpoints
.ipynb_checkpoints/

# OS cruft
.DS_Store
Thumbs.db
